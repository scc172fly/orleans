# Click-Once 目录
publish/

# Web 发布输出
*.[Pp]ublish.xml
*.azurePubxml
# TODO: 如果要将 Web 部署设置签入仓库，请注释掉下一条规则，
# 但数据库连接字符串（可能含有密码）将不会加密。
*.pubxml
*.publishproj

# NuGet 包
*.nupkg
# 使用包还原功能，因此可以忽略 packages 文件夹，
**/packages/*
# 但 build/ 除外，该目录用作 MSBuild 目标。
!**/packages/build/
# 若使用旧版集成于 MSBuild 的包还原功能，请取消以下注释：
#!**/packages/repositories.config
# 自动下载的 nuget.exe
**/[Nn]u[Gg]et.exe
*.lock.json
*.nuget.props
*.nuget.targets

# Windows Azure 构建输出
csx/
*.build.csdef

# Windows 应用商店应用包目录
AppPackages/

