<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Benchmarks</RootNamespace>
    <AssemblyName>Benchmarks</AssemblyName>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <DebugSymbols>true</DebugSymbols>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>Benchmarks.Program</StartupObject>
    <!-- 不要针对 Protocol Buffers 代码生成导致的错误发出警告，例如："error CS8981: The type name 'pb' only contains lower-cased ascii characters. Such names may become reserved for the language." -->
    <NoWarn>$(NoWarn);8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BenchmarkDotNet.Diagnostics.Windows" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis" />
    <!-- 暂时保留，以解决 Microsoft.Azure.DocumentDB.Core 的依赖项之间的冲突。 -->
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="ZeroFormatter" />
    <PackageReference Include="Utf8Json" />
    <PackageReference Include="SpanJson" />
    <PackageReference Include="Hyperion" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable\Orleans.Durable.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Durable.AzureStorage\Orleans.Durable.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Persistence.AzureStorage\Orleans.Persistence.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\Azure\Orleans.Transactions.AzureStorage\Orleans.Transactions.AzureStorage.csproj" />
    <ProjectReference Include="$(SourceRoot)src\AdoNet\Orleans.Persistence.AdoNet\Orleans.Persistence.AdoNet.csproj" />
    <ProjectReference Include="..\Grains\TestGrainInterfaces\TestGrainInterfaces.csproj" />
    <ProjectReference Include="..\Grains\BenchmarkGrains\BenchmarkGrains.csproj" />
    <ProjectReference Include="..\TestInfrastructure\TestExtensions\TestExtensions.csproj" />
    <ProjectReference Include="..\..\src\Dashboard\Orleans.Dashboard\Orleans.Dashboard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\playground\DurableJobsJournaling\StorageBackend.cs" Link="Journaling\Azure\StorageBackend.cs" />
    <Protobuf Include="Serialization\Models\ProtoIntClass.proto" GrpcServices="None" />
  </ItemGroup>

</Project>
