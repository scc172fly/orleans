<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Durable.Abstractions</PackageId>
    <Title>Microsoft Orleans Durable Abstractions</Title>
    <Description>Programming model abstractions for durable asynchronous operations in Microsoft Orleans.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <IsOrleansFrameworkPart>false</IsOrleansFrameworkPart>
    <OrleansBuildTimeCodeGen>false</OrleansBuildTimeCodeGen>
    <EnableOrleansContractsAnalyzer>false</EnableOrleansContractsAnalyzer>
    <OrleansPackageValidationBaselineSuffix>alpha.1</OrleansPackageValidationBaselineSuffix>
    <!-- 在首个版本建立包基准的同时，验证框架资产。 -->
    <OrleansPackageValidationBaselineVersion></OrleansPackageValidationBaselineVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <VersionSuffix Condition="$(VersionSuffix) != ''">$(VersionSuffix).alpha.1</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- 宿主进入记录覆盖区域（DurableTaskContext.EnterCoveredRegion、RunInCoveredFlowAsync），这些方法仍为内部成员。 -->
    <InternalsVisibleTo Include="Orleans.Durable" />
  </ItemGroup>

  <ItemGroup>
    <!-- 提供 [Alias] 特性，为持久化类型指定稳定的线协议名称。 -->
    <ProjectReference Include="..\Orleans.Serialization.Abstractions\Orleans.Serialization.Abstractions.csproj" />
    <ProjectReference Include="..\Orleans.Durable.Analyzers\Orleans.Durable.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="..\Orleans.Durable.Analyzers\bin\$(Configuration)\netstandard2.0\Orleans.Durable.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Remove="Orleans.Metadata.FrameworkPartAttribute" />
  </ItemGroup>
</Project>
