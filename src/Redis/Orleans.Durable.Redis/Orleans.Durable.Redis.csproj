<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Durable.Redis</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionSuffix Condition="$(VersionSuffix) != ''">$(VersionSuffix).alpha.1</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
    <OrleansPackageValidationBaselineSuffix>alpha.1</OrleansPackageValidationBaselineSuffix>
    <!-- 在首个版本建立包基准的同时，验证框架资产。 -->
    <OrleansPackageValidationBaselineVersion></OrleansPackageValidationBaselineVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- 此包使用 Orleans.Durable 的内部实现，因此依赖该包的精确版本。 -->
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable\Orleans.Durable.csproj" PackExactVersion="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Durable.Redis.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
