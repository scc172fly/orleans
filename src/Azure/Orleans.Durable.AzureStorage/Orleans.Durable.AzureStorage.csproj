<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Microsoft.Orleans.Durable.AzureStorage</PackageId>
    <Title>Microsoft Orleans Durable Azure Storage Providers</Title>
    <Description>Azure Blob Storage and Azure Table Storage providers for Microsoft Orleans journaling and durable jobs.</Description>
    <PackageTags>$(PackageTags) Durable Journaling Jobs Azure Storage</PackageTags>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <VersionSuffix Condition="$(VersionSuffix) != ''">$(VersionSuffix).alpha.1</VersionSuffix>
    <VersionSuffix Condition="$(VersionSuffix) == ''">alpha.1</VersionSuffix>
    <OrleansPackageValidationBaselineSuffix>alpha.1</OrleansPackageValidationBaselineSuffix>
    <!-- 在首个版本建立包基准的同时，验证框架资产。 -->
    <OrleansPackageValidationBaselineVersion></OrleansPackageValidationBaselineVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <OrleansBuildTimeCodeGen>true</OrleansBuildTimeCodeGen>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SourceRoot)src\Orleans.Runtime\Orleans.Runtime.csproj" />
    <!-- 此包使用 Orleans.Durable 的内部实现，因此依赖该包的精确版本。 -->
    <ProjectReference Include="$(SourceRoot)src\Orleans.Durable\Orleans.Durable.csproj" PackExactVersion="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orleans.Azure.Tests" />
    <InternalsVisibleTo Include="Orleans.Journaling.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
