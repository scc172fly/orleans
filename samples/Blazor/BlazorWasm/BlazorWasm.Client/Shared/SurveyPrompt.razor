<div class="alert alert-secondary mt-4" role="alert">
    <span class="oi oi-pencil mr-2" aria-hidden="true"></span>
    <strong>@Title</strong>

    <span class="text-nowrap">
        请填写我们的
        <a target="_blank" class="font-weight-bold" href="https://go.microsoft.com/fwlink/?linkid=2086020">简短问卷</a>
    </span>
    ，并告诉我们你的想法。
</div>

@code {
    // 演示父组件如何提供参数
    [Parameter]
    public string Title { get; set; } = null!;
}
