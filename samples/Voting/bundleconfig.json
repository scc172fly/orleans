// 配置项目的打包与压缩。
// 更多信息请参阅 https://go.microsoft.com/fwlink/?LinkId=808241
[
  {
    "outputFileName": "wwwroot/css/site.min.css",
    // 相对输入文件路径的数组。支持通配符模式
    "inputFiles": [
      "wwwroot/css/site.css"
    ]
  },
  {
    "outputFileName": "wwwroot/js/site.min.js",
    "inputFiles": [
      "wwwroot/js/site.js"
    ],
    // 可选择指定压缩选项
    "minify": {
      "enabled": true,
      "renameLocals": true
    },
    // 可选择生成 .map 文件
    "sourceMap": false
  }
]
