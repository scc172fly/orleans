@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">错误。</h1>
<h2 class="text-danger">处理请求时发生了错误。</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>请求 ID：</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>开发模式</h3>
<p>
    切换到 <strong>Development</strong> 环境会显示所发生错误的更详细信息。
</p>
<p>
    <strong>已部署的应用不应启用 Development 环境</strong>，否则可能会向最终用户显示异常中的敏感信息。进行本地调试时，可启用开发环境：将 <strong>ASPNETCORE_ENVIRONMENT</strong> 环境变量设置为 <strong>Development</strong>，然后重新启动应用。
</p>
