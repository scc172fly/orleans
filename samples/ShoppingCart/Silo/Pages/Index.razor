@page "/"

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16">
    <MudText Typo=Typo.h4 Class="pb-4">欢迎使用 Orleans 购物车</MudText>
    <MudList T="string" ReadOnly="true">
        <MudListItem T="string">
            使用 <strong>选购商品</strong> 链接将商品加入购物车。
        </MudListItem>
        <MudListItem T="string">
            使用 <strong>商品管理</strong> 链接管理商品或创建新商品。
        </MudListItem>
        <MudListItem T="string">
            使用 <strong>购物车</strong> 链接管理或查看已加入购物车的全部商品。
        </MudListItem>
    </MudList>
</MudContainer>