@page "/todolist/{ListId}"
<PageTitle>待办清单 - @ListId</PageTitle>
<div class="d-flex flex-column">
    <div class="row">
        <div class="col-md-6">
            <h2>待办清单：@ListId</h2>
        </div>
        <div class="col-md-6">
            <h2>事件历史</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            @if (IsViewingHistory)
            {
                <div class="alert alert-warning" role="alert">
                    <strong>正在查看历史版本</strong>
                    <span>截至 @currentViewTimestamp.Value.ToLocalTime().ToString("g").</span>
                    <a @onclick:preventDefault @onclick:stopPropagation @onclick="ReturnToCurrentVersion" href="#" class="link-offset-2">返回当前版本</a>.
                </div>
            }
            else
            {
                <form @onsubmit="AddItem">
                    <div class="input-group input-group-lg">
                        <input type="text" class="form-control" placeholder="添加新的待办事项..." @bind="newItemTitle" autofocus />
                        <button type="submit" class="btn btn-primary" disabled="@IsViewingHistory">添加</button>
                    </div>
                </form>
            }
        </div>

        <div class="col-md-6">
            <div class="alert alert-info" role="alert">
                下方是清单的历史记录。点击一条变更即可查看该时刻的待办清单。
            </div>
        </div>
    </div>

    <div class="row flex-grow-1">
        <div class="col-md-6 d-flex flex-column" style="height: calc(100vh - 200px); overflow-y: auto;">
            @if (todoList is null)
            {
                <div>正在加载...</div>
            }
            else if (todoList.Items.IsEmpty)
            {
                <div class="alert alert-info">此清单中尚无待办事项。请在上方添加！</div>
            }
            else
            {
                <div class="d-flex flex-column">
                    @foreach (var item in todoList.Items)
                    {
                        <div class="input-group mb-3" @key="item.Id">
                            <div class="input-group-text">
                                <input class="form-check-input mt-0" type="checkbox"
                                       checked="@item.IsCompleted" @onchange="() => ToggleItem(item.Id)"
                                       aria-label="切换待办事项的完成状态"
                                       disabled="@IsViewingHistory">
                            </div>
                            <input type="text" class="form-control" aria-label="待办事项内容"
                                   value="@item.Title"
                                   @onchange="(e) => UpdateItem(item.Id, e.Value as string)"
                                   disabled="@(IsViewingHistory || item.IsCompleted)">
                            <button class="btn btn-danger" type="button"
                                    @onclick="() => RemoveItem(item.Id)"
                                    disabled="@IsViewingHistory">
                                移除
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-md-6 d-flex flex-column" style="height: calc(100vh - 200px); overflow-y: auto;">
            @if (history.IsDefault)
            {
                <div>正在加载历史记录...</div>
            }
            else if (history.IsEmpty)
            {
                <div class="alert alert-info">尚无历史记录。</div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var evt in history.OrderByDescending(e => e.Timestamp))
                    {
                        <button type="button" class="list-group-item list-group-item-action @(IsCurrentHistoryItem(evt) ? "list-group-item-primary" : "list-group-item-light")"
                                aria-current="@IsCurrentHistoryItem(evt)"
                                @onclick="() => ViewAtTimestamp(evt.Timestamp)">
                            <small class="text-muted">@evt.Timestamp.ToLocalTime().ToString("g")</small>
                            <div>@evt.GetDescription()</div>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
</div>
