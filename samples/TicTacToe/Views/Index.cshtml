@model TicTacToe.Controllers.ViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="//netdna.bootstrapcdn.com/bootstrap/3.0.0/css/bootstrap.min.css" rel="stylesheet">
        <script src="//cdnjs.cloudflare.com/ajax/libs/jquery/2.0.3/jquery.min.js" type="text/javascript"></script>
        <script src="//cdnjs.cloudflare.com/ajax/libs/handlebars.js/1.0.0/handlebars.min.js" type="text/javascript"></script>
        <script src="./app.js" type="text/javascript"></script>
        <script src="//netdna.bootstrapcdn.com/bootstrap/3.0.0/js/bootstrap.min.js"></script>
        <title>井字棋</title>
        <style>
            .container {
                width: 970px;
            }
            .cell {
                width:100px;
                height:100px;
                text-align:center;
                font-size: 3rem;
            }
            .cell a {
                font-size: 1.5rem;
            }
        </style>
    </head>
    <body>
        <div class="container jumbotron">
            <h1>井字棋</h1>
        </div>
        <div class="container">

        </div>
        <div id="games-placeholder" class="container">

        </div>
        <div id="board-placeholder" class="container" style="display:none">

        </div>

        <script id="board-template" type="text/x-handlebars-template">
            <a href="javascript:void(0);" style="margin-top:8px;margin-bottom:8px" onclick="oxo.controllers.showGames();">&larr; 返回游戏列表</a>
            <h3>
                {{summary.name}}
                {{#if summary.yourMove}}
                &nbsp;<small><label class="label label-danger">轮到你落子</label></small>
                {{/if}}
            </h3>
            <p>你执 <strong>{{#if summary.gameStarter}}O{{else}}X{{/if}}</strong></p>
            <p>对手：<strong>{{#each summary.usernames}}{{this}}{{/each}}</strong></p>
            <p>已落子 <strong>{{summary.numMoves}}</strong> 步</p><br />
            <table class="table-bordered">
                <tr><td class="cell">{{{board.x0y0}}}</td><td class="cell">{{{board.x1y0}}}</td><td class="cell">{{{board.x2y0}}}</td></tr>
                <tr><td class="cell">{{{board.x0y1}}}</td><td class="cell">{{{board.x1y1}}}</td><td class="cell">{{{board.x2y1}}}</td></tr>
                <tr><td class="cell">{{{board.x0y2}}}</td><td class="cell">{{{board.x1y2}}}</td><td class="cell">{{{board.x2y2}}}</td></tr>
            </table>
        </script>

        <script id="games-template" type="text/x-handlebars-template">
            <h3>你的游戏</h3>
            <ul style="margin-bottom:25px">
                {{#each currentGames}}
                    <li>

                        {{#if waiting}}
                            <h4>
                               {{name}}
                            </h4>
                            <strong>正在等待另一位玩家</strong><br />
                            <a class="btn btn-default" onclick="oxo.controllers.showInvite('{{gameId}}')" href="javascript:void(0);">邀请好友</a>
                        {{else}}
                            <h4>
                                <a href="javascript:void(0);" onclick="oxo.controllers.play('{{gameId}}')">
                                    {{name}}
                                </a>
                                {{#if yourMove}}
                                &nbsp;<small><label class="label label-danger">轮到你落子</label></small>
                                {{/if}}
                            </h4>
                            对手：<strong>{{#each usernames}}{{this}}{{/each}}</strong><br />
                            已落子 <strong>{{numMoves}}</strong> 步
                        {{/if}}

                    </li>
                {{else}}
                <li><i>暂无游戏</i></li>
                {{/each}}

            </ul>

            <h3>可加入的游戏</h3>
            <ul style="margin-bottom:25px">
                {{#each availableGames}}
                <li>
                    <h4>
                        {{name}}
                    </h4>
                    <strong>正在等待另一位玩家</strong><br />
                    <a class="btn btn-default" onclick="oxo.controllers.joinThisGame('{{gameId}}')" href="javascript:void(0);">加入</a>
                </li>
                {{else}}
                    <li><i>暂无游戏</i></li>
                {{/each}}

            </ul>

            <a id="startNewBtn" class="btn btn-primary" href="javascript:void(0);" onclick="oxo.controllers.createGame();">开始新游戏</a>
            <a id="joinBtn" class="btn btn-success" href="javascript:void(0);" onclick="oxo.controllers.showJoinDialog();">加入游戏</a>
        </script>

        <div class="modal fade" id="enter-name-modal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">你好！请输入你的名字</h4>
                    </div>
                    <div class="modal-body">
                        <p>
                            <label for="enter-name-input">你的名字</label>
                            <input type="text" class="form-control" id="enter-name-input" placeholder="请输入你的名字"/>
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="enterNameOk">确定</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->

        <div class="modal fade" id="join-game-modal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title">加入游戏</h4>
                    </div>
                    <div class="modal-body">
                        <p>
                            <label for="join-game-input">游戏 ID</label>
                            <input type="text" class="form-control" id="join-game-input" placeholder="请输入游戏 ID">
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
                        <button type="button" class="btn btn-success" id="joinConfirmButton">加入</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->

        <div class="modal fade" id="invite-game-modal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title">邀请好友加入游戏</h4>
                    </div>
                    <div class="modal-body">
                        <p>
                            <label for="invite-game-id">将此游戏 ID 发送给好友</label>
                            <input type="text" class="form-control" id="invite-game-id" />
                            <label for="invite-game-link">或将此链接发送给他们</label>
                            <input type="text" class="form-control" id="invite-game-link" />
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" data-dismiss="modal">确定</button>
                    </div>
                </div><!-- /.modal-content -->
            </div><!-- /.modal-dialog -->
        </div><!-- /.modal -->
    </body>
</html>
