---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ApiBreadcrumbs from '../../../../components/api/ApiBreadcrumbs.astro';
import ApiLinks from '../../../../components/api/ApiLinks.astro';
import { getPackages } from '../../../../lib/api/collection';
import {
  packagePath,
  packageSlug,
  withBase,
} from '../../../../lib/api/packages';
import { buildApiSidebar } from '../../../../lib/api/sidebar';

const packages = (await getPackages()).map((entry) => entry.data);
const sidebar = buildApiSidebar(packages);
const base = import.meta.env.BASE_URL;
const headings = packages.map((pkg) => ({
  depth: 2 as const,
  slug: packageSlug(pkg.package.name),
  text: pkg.package.name,
}));
---

<StarlightPage
  frontmatter={{
    title: '.NET Orleans API 参考',
    description: '浏览直接从 Orleans 包生成的 API 文档。',
    editUrl: false,
    prev: false,
    next: false,
    tableOfContents: false,
    pagefind: true,
  }}
  sidebar={sidebar}
  headings={headings}
>
  <ApiBreadcrumbs items={[{ label: '文档', href: withBase(base, '/docs/') }, { label: 'API 参考' }]} />
  <p>
    浏览基于 Orleans 程序集、XML 注释和 Source Link 元数据
    生成的包、类型和成员文档。
  </p>
  <ApiLinks markdown={withBase(base, '/docs/api/csharp.md')} />
  {
    packages.length === 0 ? (
      <aside class="api-empty">
        <h2>尚未生成 API 元数据</h2>
        <p>
          请将 PackageJsonGenerator 的输出放入 <code>docs/site/src/data/pkgs</code>。
          构建时将自动生成成员页面、侧边栏、搜索及 Markdown 路由。
        </p>
      </aside>
    ) : (
      <div class="api-package-grid">
        {packages.map((pkg) => (
          <article>
            <h2 id={packageSlug(pkg.package.name)}>
              <a href={withBase(base, packagePath(pkg.package.name))}>{pkg.package.name}</a>
            </h2>
            <p>
              <strong>{pkg.package.version}</strong> · {pkg.package.targetFramework}
            </p>
            <p>{pkg.types.length} 个公共类型</p>
          </article>
        ))}
      </div>
    )
  }
</StarlightPage>

<style>
  .api-empty {
    margin-block-start: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav);
  }

  .api-empty h2 {
    margin-block-start: 0;
  }

  .api-package-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1rem;
    margin-block-start: 1.5rem;
  }

  .api-package-grid article {
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.6rem;
    background: var(--sl-color-bg-nav);
  }

  .api-package-grid h2 {
    margin-block-start: 0;
    font-size: 1.1rem;
    overflow-wrap: anywhere;
  }
</style>
