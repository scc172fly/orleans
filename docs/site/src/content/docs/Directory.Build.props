<Project>
  <!-- 10.2.2 支块项目中央集建的 Orleans 10.2.2 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 禁用 git 工作树兼容性 SourceLink -->
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
  
  <!-- Orleans 10.2.2 中央包件版本 -->
  <ItemGroup>
    <PackageReference Update="Microsoft.Orleans.Sdk" Version="10.2.2" />
    <PackageReference Update="Microsoft.Orleans.Server" Version="10.2.2" />
    <PackageReference Update="Microsoft.Orleans.Client" Version="10.2.2" />
    <PackageReference Update="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Update="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>
</Project>
