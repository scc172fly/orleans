<Project Sdk="Microsoft.NET.Sdk">

  <!--
    持久化任务分析器页面 ORLEANS0200 至 ORLEANS0228 的示例。
    分析器在此项目中运行，构建将其诊断作为错误处理，以确保每个修复示例均可顺利编译。
    每个违规示例在自己的代码区域前后禁用其演示的诊断规则。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <OrleansDocumentationTargetFrameworkException>The durable packages target net11.0 only.</OrleansDocumentationTargetFrameworkException>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\..\..\..\..\'))</RepositoryRoot>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 持久化 Grain 状态是实验性功能。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- 将信息级别的规则报告为警告，使构建检查每条规则的修复示例。 -->
    <GlobalAnalyzerConfigFiles Include="durable-task-rules.globalconfig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Server\Orleans.Server.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable\Orleans.Durable.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable.Abstractions\Orleans.Durable.Abstractions.csproj" />
    <ProjectReference Include="$(RepositoryRoot)src\Orleans.Durable.Analyzers\Orleans.Durable.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
