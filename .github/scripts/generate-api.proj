<Project DefaultTargets="GenerateApi">
  <ItemGroup>
    <ApiProject Include="$(MSBuildThisFileDirectory)..\..\src\**\*.csproj"
                Exclude="$(MSBuildThisFileDirectory)..\..\src\**\bin\**;$(MSBuildThisFileDirectory)..\..\src\**\obj\**;$(MSBuildThisFileDirectory)..\..\src\Orleans.Analyzers*\**;$(MSBuildThisFileDirectory)..\..\src\*.Analyzers\**;$(MSBuildThisFileDirectory)..\..\src\Orleans.CodeGenerator*\**" />
    <!-- NuGet 一起遍历所有入口点，并对它们的共享依赖项去重。 -->
    <RestoreGraphProjectInputItems Include="@(ApiProject->'%(FullPath)')" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\NuGet.targets" />

  <!-- 各 API 公开接口取自 net10.0；仅面向更新框架的项目则取自 net11.0。 -->
  <Target Name="SelectApiFramework">
    <MSBuild Projects="@(ApiProject)" Targets="GetTargetFrameworks" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ApiProjectFrameworks" />
    </MSBuild>
    <ItemGroup>
      <_ApiProjectFrameworks ApiTargetFramework="net10.0" Condition="$([System.String]::Copy(';%(TargetFrameworks);').Contains(';net10.0;'))" />
      <_ApiProjectFrameworks ApiTargetFramework="net11.0" Condition="'%(_ApiProjectFrameworks.ApiTargetFramework)' == ''" />
      <ApiBuildProject Include="@(_ApiProjectFrameworks->'%(MSBuildSourceProjectFile)')"
                       AdditionalProperties="TargetFramework=%(_ApiProjectFrameworks.ApiTargetFramework)" />
    </ItemGroup>
  </Target>

  <Target Name="Build" DependsOnTargets="SelectApiFramework">
    <MSBuild Projects="@(ApiBuildProject)"
             Targets="Build"
             BuildInParallel="true" />
  </Target>

  <!-- 仅在整个构建成功之后，使用已生成的程序集及其引用进行生成。 -->
  <Target Name="GenerateApi" DependsOnTargets="Build">
    <MSBuild Projects="@(ApiBuildProject)"
             Targets="GenAPIGenerateReferenceAssemblySource"
             Properties="BuildProjectReferences=false"
             BuildInParallel="true" />
  </Target>
</Project>